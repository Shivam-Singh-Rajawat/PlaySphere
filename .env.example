# LOCAL DEVELOPMENT: copy this to .env and export variables in your shell, or use a local env loader.
# VERCEL: add these in Project → Settings → Environment Variables (Production + Preview).
# Generate a NEW 48+ character random value; do not commit real credentials.
PLAYSPHERE_SECRET_KEY=replace-with-a-unique-long-random-secret-minimum-32-chars

# VERCEL REQUIRES A PERSISTENT DATABASE (Neon, Supabase, Vercel Postgres, etc.)
# Use the PostgreSQL pooler URL with sslmode=require (where your provider requires SSL).
# Neon example: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
PLAYSPHERE_DATABASE_URL=sqlite:///./playsphere.db

# Configure Cloudinary for direct video uploads on Vercel (free-tier limits may apply).
# All three values must be set. Never expose API_SECRET to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only in local development; Vercel never stores permanent media locally.
PLAYSPHERE_UPLOAD_DIR=./uploads
